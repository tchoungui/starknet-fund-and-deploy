# Sepolia RPC (any v0.8 JSON-RPC endpoint: Alchemy, Blast, Infura, Nethermind public...)
RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_8

# A deployed, STRK-funded account that pays for the demos (faucet: https://starknet-faucet.vercel.app)
FUNDER_ADDRESS=0x...
FUNDER_PRIVATE_KEY=0x...

# Account class to deploy (default: OpenZeppelin account; verify against the OZ release you trust)
ACCOUNT_CLASS_HASH=0x061dac032f228abef9c6626f995015233097ae253a7f72d68552db02f2971b8f

# STRK to seed each new wallet with, in wei (0.01 STRK)
FUND_AMOUNT_WEI=10000000000000000

# Strategy B only: address printed by `node deploy-factory.mjs`
FACTORY_ADDRESS=0x...
